{
  "name": "studioz-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:local": "node scripts/qa/build-local.mjs",
    "start": "next start",
    "start:local": "node scripts/qa/build-local.mjs --serve",
    "test:next:local": "node scripts/qa/smoke-next-local.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:local": "npm run test:unit && npm run typecheck && npm run lint",
    "test:browser:local": "playwright test --config tests/browser/playwright.config.ts",
    "test:bold": "vitest run tests/bold-contract.test.ts tests/payment-surfaces.test.tsx tests/payment-jobs.test.ts tests/payment-actions.test.ts tests/payment-admin.test.ts",
    "test:sql:syntax": "node scripts/qa/check-sql-syntax.mjs",
    "test:e2e": "playwright test",
    "test:e2e:prod:admin-session": "npm run build && PLAYWRIGHT_BASE_URL=http://127.0.0.1:3100 PLAYWRIGHT_WEB_SERVER_COMMAND='npm run start -- --hostname 127.0.0.1 --port 3100' playwright test e2e/admin-session-recovery.spec.ts --project=desktop-chromium",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:bunny": "PLAYWRIGHT_BUNNY_ENABLED=1 playwright test e2e/bunny-integration.spec.ts --project=desktop-chromium",
    "auth:cleanup-deleted-users": "node scripts/auth/cleanup-deleted-users.mjs",
    "qa:seed": "node scripts/qa/seed-staging.mjs",
    "qa:reset": "node scripts/qa/reset-staging.mjs"
  },
  "dependencies": {
    "@react-email/components": "1.0.12",
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.114.0",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "0.577.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.25.0",
    "sharp": "0.35.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tus-js-client": "^4.3.1"
  },
  "overrides": {
    "brace-expansion@^1.1.7": "1.1.18"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "jsdom": "30.0.1",
    "libpg-query": "18.1.4",
    "pgsql-parser": "18.2.6",
    "shadcn": "4.20.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
