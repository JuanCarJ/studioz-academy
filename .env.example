# ============================================================
# Studio Z Academy — Environment Variables
# Copy this file to .env.local and fill in the values
# See: docs/operacion/MANEJO_SECRETOS.md
# ============================================================

# Supabase (new key format: publishable replaces anon, secret replaces service_role)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxx

# Bold — activación explícita después de probar claves y webhook en staging
APP_ENVIRONMENT=local
BOLD_ENVIRONMENT=sandbox
BOLD_IDENTITY_KEY=
BOLD_SECRET_KEY=
BOLD_CHECKOUT_ENABLED=false
BOLD_SETTLEMENT_ENABLED=false
BOLD_ALLOW_EMPTY_SANDBOX_WEBHOOK_KEY=false

# Solo conciliación histórica Wompi. No habilita compras nuevas.
WOMPI_LEGACY_SETTLEMENT_ENABLED=false
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_API_BASE_URL=https://sandbox.wompi.co/v1

# Bunny Stream
BUNNY_API_KEY=xxxxx-xxxxx-xxxxx
BUNNY_LIBRARY_ID=12345
BUNNY_CDN_HOSTNAME=vz-xxxxx.b-cdn.net
BUNNY_TOKEN_AUTH_KEY=xxxxx
BUNNY_WEBHOOK_SECRET=
# legacy predeterminado; v2 requiere validar la configuración de la biblioteca
BUNNY_PLAYER_VERSION=legacy

# Email (Resend)
RESEND_API_KEY=re_xxxxx

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Secreto largo independiente para los tres jobs; nunca NEXT_PUBLIC
CRON_SECRET=

# Optional: protected staging on Vercel
# Use the same value configured in Vercel "Protection Bypass for Automation"
VERCEL_AUTOMATION_BYPASS_SECRET=

# Optional: QA Bunny media IDs for shared Playwright/staging seeds
QA_BUNNY_PREVIEW_VIDEO_ID=
QA_BUNNY_LESSON_VIDEO_ID_PREVIEW=
QA_BUNNY_LESSON_VIDEO_ID_MAIN=
